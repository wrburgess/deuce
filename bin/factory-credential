#!/usr/bin/env bash
# bin/factory-credential — store the factory's tracker credential, having first
# proved it works. Takes the token on stdin, never on a command line:
#   pbpaste | bash bin/factory-credential
#   op read "op://<vault>/<item>/credential" | bash bin/factory-credential
set -euo pipefail
cd "$(dirname "$0")/.."
exec node tools/factory/credential-run.ts
